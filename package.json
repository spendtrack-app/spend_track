{
  "name": "spend-track",
  "version": "1.0.0",
  "private": true,
  "description": "Spending tracker with MySQL-backed accounts",
  "main": "server/index.js",
  "engines": {
    "node": ">=21"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "migrate": "node scripts/migrate.js",
    "setup": "bash scripts/setup.sh",
    "test": "node --test test/*.test.js",
    "tunnel": "bash scripts/tunnel.sh",
    "smoke": "node scripts/smoke.js",
    "e2e": "playwright test",
    "doctor": "node scripts/doctor.js",
    "test:all": "npm test && npm run smoke && npm run e2e",
    "smoke:pages": "node scripts/smoke.js --pages https://spendtrack-app.github.io/spend_track/",
    "e2e:pages": "E2E_BASE_URL=https://spendtrack-app.github.io/spend_track/ playwright test",
    "pages:api": "bash scripts/pages-api.sh"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "mysql2": "^3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
