# Template only. Do NOT put real values in this file.
# Real config lives OUTSIDE the repo at ~/.config/spend_track/.env (created by `npm run setup`),
# or set SPEND_TRACK_ENV_FILE to another path. Environment variables override the file.
DB_HOST=your-db.xxxxxxxx.us-east-2.rds.amazonaws.com
DB_PORT=3306
DB_USER=spend_track_app          # runtime: data read/write only
DB_PASSWORD=
DB_MIGRATE_USER=spend_track_migrator  # optional: schema changes (npm run migrate)
DB_MIGRATE_PASSWORD=
DB_NAME=spend_track
DB_SSL=required            # "off" only for a local MySQL
DB_SSL_CA=/Users/you/.config/spend_track/rds-global-bundle.pem
PORT=3000
HOST=0.0.0.0               # 127.0.0.1 behind a reverse proxy on the same machine
TRUST_PROXY=loopback       # who may set X-Forwarded-For: loopback (default), false, hop count, or CIDRs
ALLOWED_ORIGINS=https://spendtrack-app.github.io   # sites allowed to call the API cross-origin
# NODE_ENV=production      # production mode; marks the session cookie Secure (requires HTTPS)
# COOKIE_SECURE=false      # override the Secure flag (plain-HTTP testing only)
# SESSION_TTL_DAYS=30
# Optional: sign in with Google / GitHub (README → "Sign in with Google or GitHub").
# A provider is offered only when both its values are set.
# PUBLIC_URL=https://kuro.tail5c9ccb.ts.net   # this API's public HTTPS address (OAuth redirect URIs)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
